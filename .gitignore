# Preserve lightweight baseline models already tracked
!qualifiers/weights/mobilenet_bbox_160/best_weights.keras
!qualifiers/weights/text_cnn.keras
!qualifiers/weights/text_cnn_int8.tflite
!qualifiers/weights/dtnet_clean_p2_200ep/*.tflite
!qualifiers/weights/dtnet_nwd_tal_full6k/*.tflite

# Whitelist reproduction package weights for BTC verification (<1.2MB total)
!reproduce/weights/*.pt
!reproduce/weights/*.tflite
